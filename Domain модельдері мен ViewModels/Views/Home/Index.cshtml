@model Domain_модельдері_мен_ViewModels.ViewModels.ProductCreateViewModel

@{
    ViewData["Title"] = "Жаңа тауар тіркеу";
}

<div class="row">
    <div class="col-md-8">
        <h1>Жаңа тауар тіркеу</h1>
        <p class="text-muted">ViewModel және Data Annotations валидациясының практикалық мысалы.</p>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">@successMessage</div>
        }

        <form asp-action="Index" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control" step="0.01" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="StockQuantity" class="form-label"></label>
                    <input asp-for="StockQuantity" class="form-control" />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label"></label>
                <input asp-for="Category" class="form-control" />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SupplierEmail" class="form-label"></label>
                <input asp-for="SupplierEmail" class="form-control" />
                <span asp-validation-for="SupplierEmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SupplierEmailConfirmation" class="form-label"></label>
                <input asp-for="SupplierEmailConfirmation" class="form-control" />
                <span asp-validation-for="SupplierEmailConfirmation" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DiscountPercent" class="form-label"></label>
                <input asp-for="DiscountPercent" class="form-control" />
                <span asp-validation-for="DiscountPercent" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Тауарды тексеру</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
